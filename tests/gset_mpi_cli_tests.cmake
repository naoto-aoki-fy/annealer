set(fixture "${WORK}/gset-mpi.txt")
file(WRITE "${fixture}" "2 1\n1 2 3\n")
foreach(mode mpi-multistart mpi-replica-exchange)
    foreach(trials 1 3)
        execute_process(COMMAND ${LAUNCH} "${EXAMPLE}" "${fixture}" --mode ${mode}
            --seed 42 --trials ${trials} --levels 3 --sweeps 4 --reference-cut 3
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
        if(NOT result EQUAL 0 OR NOT output MATCHES "Best cut: 3 Best energy: -3 Verified: yes Reference gap: 0")
            message(FATAL_ERROR "${mode}: ${output} ${error}")
        endif()
        string(REGEX MATCHALL "Best seed:" summaries "${output}")
        list(LENGTH summaries count)
        if(NOT count EQUAL 1 OR NOT output MATCHES "MPI wall seconds")
            message(FATAL_ERROR "Expected one global summary with MPI timing: ${output}")
        endif()
    endforeach()
    foreach(option --trace-csv --profile --target-cut)
        foreach(existing FALSE TRUE)
            set(trace "${WORK}/gset-rejected.csv")
            file(REMOVE "${trace}")
            if(existing)
                file(WRITE "${trace}" "preserve this trace\n")
            endif()
            set(args --trace-csv "${trace}")
            if(option STREQUAL "--profile")
                set(args --profile --trace-csv "${trace}")
            elseif(option STREQUAL "--target-cut")
                set(args --target-cut 3 --trace-csv "${trace}")
            endif()
            # Test each option alone as well as together with a trace request.
            if(NOT option STREQUAL "--trace-csv")
                set(value 3)
                if(option STREQUAL "--profile")
                    set(value "")
                endif()
                execute_process(COMMAND ${LAUNCH} "${EXAMPLE}" "${fixture}" --mode ${mode} ${option} ${value}
                    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error TIMEOUT 30)
                if(result EQUAL 0 OR NOT error MATCHES "${option} currently requires serial mode")
                    message(FATAL_ERROR "Missing diagnostic for ${option}: ${error}")
                endif()
            endif()
            execute_process(COMMAND ${LAUNCH} "${EXAMPLE}" "${fixture}" --mode ${mode} ${args}
                RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error TIMEOUT 30)
            if(result EQUAL 0 OR NOT error MATCHES "currently requires serial mode")
                message(FATAL_ERROR "Invalid diagnostics accepted: ${error}")
            endif()
            if(existing)
                file(READ "${trace}" contents)
                if(NOT contents STREQUAL "preserve this trace\n")
                    message(FATAL_ERROR "Rejected request truncated trace")
                endif()
            elseif(EXISTS "${trace}")
                message(FATAL_ERROR "Rejected request created trace")
            endif()
        endforeach()
    endforeach()
endforeach()
