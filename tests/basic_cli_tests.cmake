function(check expected pattern)
    execute_process(COMMAND ${LAUNCH} "${EXAMPLE}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(expected STREQUAL "ok")
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Failed: ${ARGN}: ${status} ${error}")
        endif()
    elseif(status EQUAL 0 OR NOT status MATCHES "^[0-9]+$")
        message(FATAL_ERROR "Expected clean failure: ${ARGN}: ${status}")
    endif()
    if(NOT "${output}${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "Missing ${pattern}: ${output}${error}")
    endif()
endfunction()
check(ok "--mode" --help)
check(ok "[Bb]est" --mode serial --seed 42 --trials 2 --levels 2 --sweeps 1)
check(error "exchange options" --exchange-seed 0)
check(error "invalid unsigned" --trials -1)
check(error "seed overflow" --seed 18446744073709551615 --trials 2)
if(MPI_ENABLED)
    foreach(mode mpi-multistart mpi-replica-exchange)
        check(ok "[Gg]lobal best" --mode ${mode} --trials 3 --levels 2 --sweeps 1)
    endforeach()
    check(error "budget overflow" --mode mpi-replica-exchange --levels 18446744073709551615 --sweeps 2)
    check(error "seed overflow" --mode mpi-replica-exchange --exchange-seed 18446744073709551615 --trials 2)
else()
    foreach(mode mpi-multistart mpi-replica-exchange)
        check(error "ANNEALER_ENABLE_MPI=ON" --mode ${mode})
    endforeach()
endif()
if(MPI_ENABLED AND LAUNCH)
    execute_process(COMMAND "${EXAMPLE}" --mode mpi-multistart --seed 17 --trials 3 --levels 2 --sweeps 1
        RESULT_VARIABLE single_status OUTPUT_VARIABLE single ERROR_VARIABLE single_error TIMEOUT 30)
    execute_process(COMMAND ${LAUNCH} "${EXAMPLE}" --mode mpi-multistart --seed 17 --trials 3 --levels 2 --sweeps 1
        RESULT_VARIABLE multi_status OUTPUT_VARIABLE multi ERROR_VARIABLE multi_error TIMEOUT 30)
    if(NOT single_status EQUAL 0 OR NOT multi_status EQUAL 0 OR NOT single STREQUAL multi)
        message(FATAL_ERROR "Multi-start must be rank-count independent: ${single_error} ${multi_error}\n${single}\n${multi}")
    endif()
endif()
