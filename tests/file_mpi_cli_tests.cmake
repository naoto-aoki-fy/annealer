if(KIND STREQUAL "dimacs_coloring")
    set(data "p edge 3 3\ne 1 2\ne 2 3\ne 1 3\n")
    set(expect "Conflicting edges:")
elseif(KIND STREQUAL "maxsat")
    set(data "p wcnf 2 2 10\n10 1 0\n2 -2 0\n")
    set(expect "Soft cost: .*Hard violations:")
elseif(KIND STREQUAL "set_covering")
    set(data "2 3 5 2 8 2 1 2 2 2 3\n")
    set(expect "Best feasible cost:")
else()
    set(data "1 1 0 2\n")
    set(expect "Actual makespan: .*Precedence: .*Machine conflicts: .*Makespan bounds:")
endif()
set(fixture "${WORK}/${KIND}-mpi-fixture.txt")
file(WRITE "${fixture}" "${data}")
foreach(mode mpi-multistart mpi-replica-exchange)
    set(exchange_args "")
    if(mode STREQUAL "mpi-replica-exchange")
        set(exchange_args --exchange-interval 1 --exchange-seed 17)
    endif()
    execute_process(COMMAND ${LAUNCH} "${EXAMPLE}" "${fixture}" --mode ${mode}
        --seed 42 --trials 3 --levels 2 --sweeps 2 ${exchange_args}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT result EQUAL 0 OR NOT output MATCHES "${expect}")
        message(FATAL_ERROR "${mode}: ${result}: ${output} ${error}")
    endif()
    if(KIND STREQUAL "set_covering" AND mode STREQUAL "mpi-multistart")
        execute_process(COMMAND "${EXAMPLE}" "${fixture}" --seed 42 --trials 3 --levels 2 --sweeps 2
            RESULT_VARIABLE serial_result OUTPUT_VARIABLE serial_output ERROR_VARIABLE serial_error TIMEOUT 30)
        string(REGEX MATCH "Best feasible cost:[^\n]*" global_feasible "${output}")
        string(REGEX MATCH "Best feasible cost:[^\n]*" serial_feasible "${serial_output}")
        if(NOT serial_result EQUAL 0 OR NOT global_feasible STREQUAL serial_feasible)
            message(FATAL_ERROR "Distributed feasible summary differs from all serial starts: ${output} ${serial_output}")
        endif()
    endif()
    string(REGEX MATCHALL "Initial temperature:" headers "${output}")
    list(LENGTH headers count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one root report: ${output}")
    endif()
    foreach(args "--levels;0" "--trials;0" "--exchange-interval;0" "--seed;18446744073709551615")
        if(KIND STREQUAL "dimacs_coloring" AND args STREQUAL "--levels;0")
            continue()
        endif()
        execute_process(COMMAND ${LAUNCH} "${EXAMPLE}" "${fixture}" --mode ${mode}
            --trials 2 --levels 2 --sweeps 1 ${args}
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
        if(result EQUAL 0 OR result MATCHES "timeout")
            message(FATAL_ERROR "Invalid options did not fail cleanly: ${mode} ${args}: ${result}")
        endif()
    endforeach()
    execute_process(COMMAND ${LAUNCH} "${EXAMPLE}" "${fixture}.missing" --mode ${mode}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(result EQUAL 0 OR result MATCHES "timeout")
        message(FATAL_ERROR "Missing input did not fail cleanly: ${result}")
    endif()
endforeach()

# A non-root-only input failure must stop every rank before model/solver collectives.
if(UNIX)
    set(wrapper "${WORK}/${KIND}-rank-input.sh")
    file(WRITE "${wrapper}" "#!/bin/sh\nrank=\${OMPI_COMM_WORLD_RANK:-\${PMI_RANK:-\${PMIX_RANK:-0}}}\ninput='$fixture'\nif [ \"$rank\" != 0 ]; then input='$fixture.missing'; fi\nexec \"$1\" \"$input\" --mode \"$2\" --trials 2 --levels 2 --sweeps 1\n")
    # Use CMake substitution for the fixture while preserving shell variables.
    file(READ "${wrapper}" script)
    string(REPLACE "$fixture" "${fixture}" script "${script}")
    file(WRITE "${wrapper}" "${script}")
    foreach(mode mpi-multistart mpi-replica-exchange)
        execute_process(COMMAND ${LAUNCH} sh "${wrapper}" "${EXAMPLE}" "${mode}"
            RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
        if(result EQUAL 0 OR result MATCHES "timeout")
            message(FATAL_ERROR "Rank-local input failure was not coordinated: ${result}")
        endif()
    endforeach()
endif()
